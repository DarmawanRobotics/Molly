# /etc/molly/molly.env — read by molly.service (scripts/run_robot.sh), scripts/env.sh
# and scripts/setup.sh. Tuning parameters belong in SITE_CONFIG (src/molly_bringup/config/site.example.yaml).
# bash and systemd both read this file: quote values with spaces ("a b"), and never put a comment
# after a value (systemd keeps it as part of the value).
# Robot driver package (driver, URDF, sensors), started with namespace:=ROBOT_NS:
# <package>[/<file>.launch.py] (bringup.launch.py by default)
ROBOT_DRIVER=lite3_bringup
# Namespace of the robot driver topics and services (/<ROBOT_NS>/cmd_vel, ...)
ROBOT_NS=robot
# Command run before the stack starts, e.g. to stop a vendor autostart that drives the robot
ROBOT_PRESTART=
# The robot package's installer for scripts/setup.sh (`<script> check|install`) and its addresses
ROBOT_SETUP=/home/robot/dev/Molly/src/xtras/robots/lite3_ros2/lite3_bringup/scripts/lite3_setup.sh
ROBOT_IP=192.168.1.120
LIVOX_IP=
# START_MAPPING=true maps SITE at start when it is new    ODOMETRY: fast_lio | leg_kilo
START_MAPPING=false
ODOMETRY=fast_lio
# Site loaded at start (empty: the one of the last run) and where the sites live
SITE=
SITES_DIR=/home/robot/dev/Molly/map
# Route CSV inside SITES_DIR loaded at start, e.g. museum/routes/loop.csv (empty: the last one)
ROUTE=
# Molly's own DDS: vendor stacks on the same computer often use another RMW or domain
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# 1: ROS stays on this computer, nobody on the robot's Wi-Fi can publish to the driver (the
# dashboard goes through rosbridge, which only exposes whitelisted names).
# 0 when the robot driver runs on another computer, or to use RViz from a laptop.
ROS_LOCALHOST_ONLY=1
# Visitors around the robot from the LiDAR (the guide waits for them, the greeter greets them)
VISITORS=true
# Text to speech (setup.sh install speech: Piper voices, eSpeak NG) and greeting visitors
SPEECH=true
GREETER=true
# Answering questions with a local LLM (setup.sh install ollama, CHAT_MODEL)
CONVERSATION=false
SITE_CONFIG=/etc/molly/site.yaml
# Dashboard: rosbridge WebSocket and the camera as MJPEG (setup.sh install web)
WEB=true
WEB_PORT=9090
WEB_VIDEO_PORT=8080
# Handheld video over WebRTC through MediaMTX (scripts/setup.sh install webrtc); false: JPEG over
# the teleop link only. MEDIAMTX: that binary instead of /opt/molly/mediamtx or PATH
WEBRTC=true
MEDIAMTX=
# Library directories searched before ROS's own, e.g. /usr/local/lib for a librealsense built
# from source when the apt one prints "No RealSense devices were found!"
LD_LIBRARY_PATH_FIRST=
# Seconds the stack waits at boot for NTP to set the clock (0: no wait); a later clock jump breaks
# odometry and TF
TIME_SYNC_WAIT=60
# One OpenBLAS/OpenMP thread per node: more threads busy-wait and burn whole cores
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
