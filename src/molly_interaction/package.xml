<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>molly_interaction</name>
  <version>2.0.0</version>
  <description>Molly with visitors: text to speech (Piper or eSpeak NG), robot gestures, a greeter, an optional question answering model (Ollama), and the visitors around the robot from the LiDAR.</description>
  <maintainer email="darmawandeveloper@gmail.com">Agus Darmawan</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/DarmawanRobotics/Molly</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>dharma_utils</exec_depend>
  <exec_depend>dharma_interfaces</exec_depend>
  <exec_depend>dharma_perception</exec_depend>
  <exec_depend>molly_interfaces</exec_depend>
  <exec_depend>alsa-utils</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>tf2_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
