  QMainWindow State: 
  Status:
    collapsed: false
  StatusPanel:
    collapsed: false
  TagPanel:
    collapsed: false
  Tuning:
    collapsed: false
  TuningPanel:
    collapsed: false
  Views:
    collapsed: false
  Width: 1600
  X: 0
  Y: 27
