# /etc/molly/molly.env — read by molly.service (script/run_robot.sh), script/env.sh
# and script/setup.sh. Tuning parameters belong in SITE_CONFIG (src/molly/config/site.example.yaml).
# bash and systemd both read this file: quote values with spaces ("a b"), and never put a comment
# after a value (systemd keeps it as part of the value).
ROBOT_ID=robot-01
# Robot package (driver, URDF, sensors), see src/xtras/README.md: <package>[/<file>.launch.py]
ROBOT_BRINGUP=
# Namespace of the robot driver topics and services (/<ROBOT_NS>/cmd_vel, ...)
ROBOT_NS=robot
# Command run before the stack starts, e.g. to stop a vendor autostart that drives the robot
ROBOT_PRESTART=
# The robot package's installer for script/setup.sh (`<script> check|install`) and its SDK address
ROBOT_SETUP=
ROBOT_IP=
# MODE: patrol | teach    ODOMETRY: fast_lio | leg_kilo
MODE=patrol
ODOMETRY=fast_lio
# Route CSV loaded at start (empty: the last loaded one) and the AprilTag map poses
ROUTE=
TAGS=/home/robot/dev/Molly/map/tag_config.json
# Molly's own DDS: vendor stacks on the same computer often use another RMW or domain
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# 1: ROS stays on this computer, nobody on the robot's Wi-Fi can publish to the driver.
# 0 when the robot driver runs on another computer, or to use RViz from a laptop.
ROS_LOCALHOST_ONLY=1
# Extras, off by default (both can also be switched live from the handheld): PEOPLE counts
# people with YOLO11n on the CPU (setup.sh install people_model, no PyTorch), INSPECTION needs
# Ollama with the VLM (setup.sh install ollama)
PEOPLE=false
INSPECTION=false
SITE_CONFIG=/etc/molly/site.yaml
# Handheld video over WebRTC through MediaMTX (script/setup.sh install webrtc); false: JPEG over
# the teleop link only. MEDIAMTX: that binary instead of /opt/molly/mediamtx or PATH
WEBRTC=true
MEDIAMTX=
# NETRA command center (Pengaturan -> Robot -> Tambah gives the token)
CC_URL=
CC_TOKEN=
# Library directories searched before ROS's own, e.g. /usr/local/lib for a librealsense built
# from source when the apt one prints "No RealSense devices were found!"
LD_LIBRARY_PATH_FIRST=
# Seconds the stack waits at boot for NTP to set the clock (0: no wait); a later clock jump breaks
# odometry and TF
TIME_SYNC_WAIT=60
# One OpenBLAS/OpenMP thread per node: more threads busy-wait and burn whole cores
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
